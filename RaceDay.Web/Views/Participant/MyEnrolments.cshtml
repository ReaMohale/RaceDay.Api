@model List<EnrolmentItem>
@{
    ViewData["Title"] = "My enrolments";
}
<h1 class="rd-display-sm mb-4">My enrolments</h1>

@if (Model.Count == 0)
{
    <div class="rd-empty">
        <p>You have not entered any events yet.</p>
        <a asp-controller="Home" asp-action="Index" class="btn rd-btn-primary">Browse events</a>
    </div>
}
else
{
    <div class="table-responsive rd-table-wrap">
        <table class="table rd-table align-middle mb-0">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Category</th><th>Entered on</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a asp-controller="Events" asp-action="Details" asp-route-id="@item.EventId">@item.EventName</a></td>
                        <td>@Format.ShortDate(item.EventDate)</td>
                        <td>@item.CategoryName</td>
                        <td>@Format.DateTimeShort(item.EnrolmentDate)</td>
                        <td><span class="@Format.StatusCss(item.Status, item.HasResult)">@Format.StatusText(item.Status, item.HasResult)</span></td>
                        <td class="text-end">
                            @if (!item.HasResult)
                            {
                                <form asp-controller="Participant" asp-action="Cancel" method="post" data-confirm="Cancel your enrolment in @item.EventName?">
                                    <input type="hidden" name="enrolmentId" value="@item.EnrolmentId" />
                                    <button type="submit" class="btn btn-sm rd-btn-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
