@model List<ResultItem>
@{
    ViewData["Title"] = "My results";
}
<h1 class="rd-display-sm mb-4">My results</h1>

@if (Model.Count == 0)
{
    <div class="rd-empty">
        <p>No results yet. Once an organiser publishes your finish time it will appear here.</p>
        <a asp-controller="Participant" asp-action="MyEnrolments" class="btn rd-btn-primary">View my enrolments</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var result in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="rd-panel h-100 rd-result-card">
                    <div class="rd-meta">@Format.ShortDate(result.EventDate)</div>
                    <h2 class="h5 mb-1">@result.EventName</h2>
                    <div class="rd-meta mb-3">@result.CategoryName</div>
                    <div class="rd-time">@Format.Time(result.FinishTime)</div>
                    @if (result.Position is not null)
                    {
                        <div class="rd-position">
                            <span class="rd-pos-badge">@Format.Ordinal(result.Position.Value)</span>
                            <span>out of @result.TotalFinishers @(result.TotalFinishers == 1 ? "finisher" : "finishers")</span>
                        </div>
                    }
                    else
                    {
                        <div class="rd-meta">Position not recorded</div>
                    }
                </div>
            </div>
        }
    </div>
}
