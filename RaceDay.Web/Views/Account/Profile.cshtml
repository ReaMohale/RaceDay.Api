@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
}
<h1 class="rd-display-sm mb-4">My profile</h1>
<div class="row g-4">
    <div class="col-md-4">
        <div class="rd-panel text-center">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="Your profile picture" class="rd-profile-img" />
            }
            else
            {
                <div class="rd-profile-img rd-profile-img--placeholder">@Format.Initials(Model.FullName)</div>
            }
            <p class="mt-3 mb-1 fw-semibold">@Model.FullName</p>
            <p class="rd-meta mb-3">@Model.Role</p>

            <form asp-action="ProfilePicture" method="post" enctype="multipart/form-data" class="text-start">
                <label for="picture" class="form-label">Change profile picture</label>
                <input id="picture" name="picture" type="file" class="form-control mb-2" accept="image/png,image/jpeg,image/gif,image/webp" required />
                <div class="form-text mb-2">JPG, PNG, GIF or WEBP, up to 5 MB.</div>
                <button type="submit" class="btn rd-btn-outline w-100">Upload picture</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="rd-panel">
            <h2 class="h5 mb-3">Personal information</h2>
            <form asp-action="Profile" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" value="@Model.Email" readonly />
                </div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn rd-btn-primary">Save changes</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
